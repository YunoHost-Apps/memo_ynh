#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================

ynh_app_setting_set_default --key=logo_url --value=""
ynh_app_setting_set_default --key=favicon_url --value=""
ynh_app_setting_set_default --key=allow_anonymous_boards --value="0"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading the memo binary..."

# The whole install dir is replaced, which is how the checkout, node_modules
# and the bundled bun of 0.9.8 and earlier are cleared out. The .env is
# rewritten from the template right below, and the boards were never in here.
memo_setup_binary

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

memo_add_config

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

memo_prepare_logs

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="$service_description" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="storing boards in"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
